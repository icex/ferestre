+/* The v2 fields a caller may change after virtual_device_init, mirrored. */
+static void virtual_device_sync_v0( struct virtual_device *device )
+{
+    device->info_v0.deviceFamily = device->info.deviceFamily;
+    device->info_v0.supportedInput = device->info.supportedInput;
+    device->info_v0.supportedRumbleMotors = device->info.supportedRumbleMotors;
+    device->info_v0.gamepadInfo = device->info.gamepadInfo;
+    device->info_v0.vendorId = device->info.vendorId;
+    device->info_v0.productId = device->info.productId;
 }
 
