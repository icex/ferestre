pkgbase = ferestre-git
	pkgdesc = Download and run the Microsoft Store and Xbox GDK titles you own, on Linux
	pkgver = 0.0.0.r18.g88a0378
	pkgrel = 1
	url = https://github.com/icex/ferestre
	install = ferestre-git.install
	arch = x86_64
	license = MIT
	license = LGPL-2.1-or-later
	license = GPL-3.0-only
	license = BSD-3-Clause
	makedepends = git
	makedepends = cargo
	depends = bash
	depends = ferestre-client
	depends = ferestre-runtime-bin
	depends = curl
	depends = unzip
	depends = python
	optdepends = steam: Proton wants STEAM_COMPAT_CLIENT_INSTALL_PATH, and a title can be added as a non-Steam shortcut
	optdepends = vulkan-tools: `vulkaninfo`, for checking the GPU side before blaming the launcher
	optdepends = docker: building the patched Proton runtime yourself (ferestre install-runtime)
	optdepends = podman: building the patched Proton runtime yourself, instead of docker
	optdepends = patch: re-applying the proton patch after a self-built runtime install
	optdepends = binutils: the runtime build checks the installed xgameruntime.dll with strings(1)
	optdepends = rsync: rebuilding a single DLL against the runtime build tree
	provides = ferestre
	conflicts = ferestre
	source = ferestre-git::git+https://github.com/icex/ferestre.git
	sha256sums = SKIP

pkgname = ferestre-git
