+static struct virtual_device *virtual_device_from_v0( IGameInputDevice_v0 *iface )
+{
+    return CONTAINING_RECORD( iface, struct virtual_device, IGameInputDevice_v0_iface );
+}
+
+/* IUnknown stays the v2 pointer, so either interface compares as one object. */
+static HRESULT WINAPI virtual_device_v0_QueryInterface( IGameInputDevice_v0 *iface, REFIID iid, void **out )
+{
+    return virtual_device_QueryInterface( &virtual_device_from_v0( iface )->IGameInputDevice_v2_iface, iid, out );
+}
+
+static ULONG WINAPI virtual_device_v0_AddRef( IGameInputDevice_v0 *iface )
