diff --git a/libs/vkd3d/command.c b/libs/vkd3d/command.c
index 611e373..a703ae2 100644
--- a/libs/vkd3d/command.c
+++ b/libs/vkd3d/command.c
@@ -2816,6 +2816,12 @@ static void d3d12_command_list_allocator_destroyed(struct d3d12_command_list *li
 {
     TRACE("list %p.\n", list);
 
+    /* The allocator owns the recording buffer. Once it is gone, Close must
+     * fail instead of submitting a null buffer, and Reset may start anew. */
+    if (list->is_recording)
+        WARN("Command allocator destroyed during recording; invalidating command list.\n");
+    list->is_recording = false;
+    list->is_valid = false;
     list->allocator = NULL;
     list->submit_allocator = NULL;
     memset(&list->cmd, 0, sizeof(list->cmd));
@@ -3039,6 +3045,7 @@ static ULONG STDMETHODCALLTYPE d3d12_command_allocator_Release(ID3D12CommandAllo
     struct d3d12_command_allocator *allocator = impl_from_ID3D12CommandAllocator(iface);
     unsigned int refcount = InterlockedDecrement(&allocator->refcount);
     unsigned int pending;
+    bool retained_recording = false;
 
     TRACE("%p decreasing refcount to %u.\n", allocator, refcount);
 
@@ -3046,11 +3053,23 @@ static ULONG STDMETHODCALLTYPE d3d12_command_allocator_Release(ID3D12CommandAllo
     {
         struct d3d12_device *device = allocator->device;
 
+        /* Some engines replace allocators while a list is still recording.
+         * Retain only that retired allocator, without changing public COM
+         * reference counts. The list drops the lease on Reset or destruction. */
+        if (VKD3D_CONFIG_FLAG_IS_SET(RETAIN_RECORDING_ALLOCATORS) &&
+                allocator->current_command_list && allocator->current_command_list->is_recording &&
+                !allocator->current_command_list->retained_recording_allocator)
+        {
+            allocator->current_command_list->retained_recording_allocator = allocator;
+            d3d12_command_allocator_inc_ref(allocator);
+            retained_recording = true;
+            TRACE("Retaining retired recording allocator %p.\n", allocator);
+        }
         d3d_destruction_notifier_notify(&allocator->destruction_notifier);
         pending = d3d12_command_allocator_dec_ref(allocator);
 
         /* If this does not go to zero, it means that there are still command lists in flight. */
-        if (pending != 0)
+        if (pending != 0 && !retained_recording)
         {
             ERR("Released all public references, but there are still %u pending command lists "
                 "awaiting execution from command allocator iface %p! Deferring release.\n", pending, iface);
@@ -6766,6 +6785,8 @@ ULONG STDMETHODCALLTYPE d3d12_command_list_Release(d3d12_command_list_iface *ifa
         hash_map_free(&list->query_resolve_lut);
         d3d12_command_list_free_rtas_batch(list);
 
+        if (list->retained_recording_allocator)
+            d3d12_command_allocator_dec_ref(list->retained_recording_allocator);
         vkd3d_free_aligned(list);
 
         d3d12_device_release(device);
@@ -7391,6 +7412,14 @@ static HRESULT STDMETHODCALLTYPE d3d12_command_list_Reset(d3d12_command_list_ifa
     {
         list->allocator = allocator_impl;
         d3d12_command_list_reset_state(list, initial_pipeline_state);
+        if (list->retained_recording_allocator &&
+                (list->retained_recording_allocator != allocator_impl ||
+                 vkd3d_atomic_uint32_load_explicit(&allocator_impl->refcount, vkd3d_memory_order_acquire)))
+        {
+            struct d3d12_command_allocator *retired = list->retained_recording_allocator;
+            list->retained_recording_allocator = NULL;
+            d3d12_command_allocator_dec_ref(retired);
+        }
     }
 
     return hr;
