+/* A title holding a pad by its v0 interface may pass that pointer back to the
+ * v2 calls, which identify devices by their v2 pointer. */
+static IGameInputDevice_v2 *virtual_device_v2( IGameInputDevice_v2 *device )
+{
+    IGameInputDevice_v0 *v0 = (IGameInputDevice_v0 *)device;
+
+    if (device && v0->lpVtbl == &virtual_device_v0_vtbl)
+        return &virtual_device_from_v0( v0 )->IGameInputDevice_v2_iface;
+    return device;
+}
+
 static struct virtual_device virtual_keyboard = { {&virtual_device_vtbl}, 1, GameInputKindKeyboard };
 static struct virtual_device virtual_mouse    = { {&virtual_device_vtbl}, 1, GameInputKindMouse };
 /* Read pads through Wine's XInput rather than enumerating a second copy of each
@@ -918,6 +1101,44 @@ static void virtual_device_init( struct virtual_device *device, const char *name
         device->mouse.hasWheelY = TRUE;
         info->mouseInfo = &device->mouse;
     }
+
+    device->IGameInputDevice_v0_iface.lpVtbl = &virtual_device_v0_vtbl;
+    device->name_v0.data = name;
+    device->name_v0.sizeInBytes = strlen( name );
+    device->name_v0.codePointCount = strlen( name );
+    memset( &device->info_v0, 0, sizeof(device->info_v0) );
+    device->info_v0.infoSize = sizeof(device->info_v0);
+    device->info_v0.usage = info->usage;
+    device->info_v0.deviceId = info->deviceId;
+    device->info_v0.deviceRootId = info->deviceRootId;
+    device->info_v0.displayName = &device->name_v0;
+    if (device->kind == GameInputKindKeyboard)
+    {
+        device->keyboard_v0.kind = device->keyboard.kind;
+        device->keyboard_v0.keyCount = device->keyboard.keyCount;
+        device->keyboard_v0.functionKeyCount = device->keyboard.functionKeyCount;
+        device->keyboard_v0.maxSimultaneousKeys = device->keyboard.maxSimultaneousKeys;
+        device->info_v0.keyboardInfo = &device->keyboard_v0;
+    }
+    else if (device->kind == GameInputKindMouse)
+    {
+        device->mouse_v0.supportedButtons = device->mouse.supportedButtons;
+        device->mouse_v0.sampleRate = device->mouse.sampleRate;
+        device->mouse_v0.hasWheelX = device->mouse.hasWheelX;
+        device->mouse_v0.hasWheelY = device->mouse.hasWheelY;
+        device->info_v0.mouseInfo = &device->mouse_v0;
+    }
+}
