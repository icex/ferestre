+static void virtual_devices_init( void )
+{
+    static BOOL done;
+    if (done) return;
+    virtual_device_init( &virtual_keyboard, "Keyboard", 0x4b, HID_USAGE_GENERIC_KEYBOARD );
+    virtual_device_init( &virtual_mouse, "Mouse", 0x4d, HID_USAGE_GENERIC_MOUSE );
+    done = TRUE;
+}
