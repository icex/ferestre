+/// Set to `1` to let a download go over a plain http CDN root the package
+/// service lists, instead of asking for the same path over https.
+pub const ALLOW_HTTP_CDN_ENV: &str = "XODUS_ALLOW_HTTP_CDN";
+
+/// Where to download a package file from: over https, whatever the package
+/// service says.
+///
+/// The service lists CDN roots, and they have been plain `http://` -- which
+/// lets anybody on the path rewrite the package, header and all, and nothing
+/// downstream could tell. An https root is taken if there is one; otherwise the
+/// first root is asked for over https. A root in any other scheme is refused.
+/// `XODUS_ALLOW_HTTP_CDN=1` keeps a plain http root as it is, for the day a CDN
+/// host does not answer https: the pages are still checked against the
+/// package's hash tree, but the header that vouches for that tree is not.
+pub fn package_url(cdn_roots: &[String], relative_url: &str) -> Result<String, String> {
+    package_url_with(
+        cdn_roots,
+        relative_url,
+        std::env::var(ALLOW_HTTP_CDN_ENV).is_ok_and(|v| v == "1"),
+    )
+}
+
+fn package_url_with(
+    cdn_roots: &[String],
+    relative_url: &str,
+    allow_http: bool,
+) -> Result<String, String> {
+    if let Some(root) = cdn_roots
+        .iter()
+        .find(|root| root.to_ascii_lowercase().starts_with("https://"))
+    {
+        return Ok(format!("{root}{relative_url}"));
+    }
+    let Some(root) = cdn_roots.first() else {
+        return Err("the package service listed no download location for this package".into());
+    };
+    let Some(rest) = root
+        .get(..7)
+        .filter(|scheme| scheme.eq_ignore_ascii_case("http://"))
+        .map(|_| &root[7..])
+    else {
+        return Err(format!(
+            "refusing the download location {root}: only https is used"
+        ));
+    };
+    if allow_http {
+        eprintln!("warning: downloading over plain http ({ALLOW_HTTP_CDN_ENV}=1)");
+        return Ok(format!("{root}{relative_url}"));
+    }
+    Ok(format!("https://{rest}{relative_url}"))
+}
