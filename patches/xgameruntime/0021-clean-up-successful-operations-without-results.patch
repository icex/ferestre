-static void complete_provider_failure( struct x_async_op *op, HRESULT hr )
+static void complete_without_result( struct x_async_op *op, HRESULT hr )
 {
     BOOL drop = FALSE;
 
@@ -231,12 +231,12 @@
         op->result = hr;
         op->required_size = 0;
         op->deliver_pending = TRUE;
-        store_async_result( op->async, hr, (void *)&failed_begin_marker, 0 );
+        store_async_result( op->async, hr, (void *)&no_result_marker, 0 );
         op->cleanup_async = *op->async;
-        op->cleanup_on_release = TRUE;
+        op->cleanup_on_release = op->provider != NULL;
         list_remove( &op->entry );
         drop = TRUE;
-        TRACE( "failed provider for block %p completes asynchronously; cleanup follows delivery.\n", op->async );
+        TRACE( "provider for block %p completes asynchronously; cleanup follows delivery.\n", op->async );
     }
     LeaveCriticalSection( &async_ops_cs );
     if (drop) release_async_op( op );
@@ -258,15 +258,15 @@
     struct x_async_op *op, *drop = NULL;
     BOOL defer = FALSE;
 
-    /* Failed operations have no result to consume. Keep the provider alive
-     * through its worker and completion callback, then clean it up even when
