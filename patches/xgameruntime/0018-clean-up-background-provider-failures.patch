+        TRACE( "failed provider for block %p completes asynchronously; cleanup follows delivery.\n", op->async );
     }
     LeaveCriticalSection( &async_ops_cs );
     if (drop) release_async_op( op );
@@ -258,6 +258,24 @@ static void x_threading_XAsyncComplete_helper( XAsyncBlock *async, HRESULT resul
     struct x_async_op *op, *drop = NULL;
     BOOL defer = FALSE;
 
+    /* Failed operations have no result to consume. Keep the provider alive
+     * through its worker and completion callback, then clean it up even when
+     * the caller only reads status. The same ownership rule applies to Begin
+     * and to a background provider failure. */
+    if (FAILED(result))
+    {
+        BOOL deliver;
+        if (!(op = acquire_async_op( async ))) return;
+        complete_provider_failure( op, result );
+        EnterCriticalSection( &async_ops_cs );
+        deliver = !op->begin_running && op->deliver_pending;
+        if (deliver) op->deliver_pending = FALSE;
+        LeaveCriticalSection( &async_ops_cs );
+        if (deliver) deliver_async_completion( async, op );
+        release_async_op( op );
+        return;
+    }
+
     EnterCriticalSection( &async_ops_cs );
     op = find_async_op( async );
     if (!op)
@@ -543,7 +561,7 @@ static HRESULT WINAPI x_threading_XAsyncBegin( IXThreadingImpl *iface, XAsyncBlo
      * the completion we accepted is still queued. An already completed
