+
+static void update_release( struct XGameSaveUpdate *update )
+{
+    struct wgs_op *op, *next;
+
+    if (InterlockedDecrement( &update->ref )) return;
+    LIST_FOR_EACH_ENTRY_SAFE( op, next, &update->ops, struct wgs_op, entry )
