+        for title_id in [4294967296, 0, -1, i64::MIN, i64::MAX] {
+            let error = win32_identity_for(&client, &manager, title_id)
+                .await
+                .err()
+                .expect("invalid title ID must fail");
+            assert_eq!(
+                error,
+                "Windows title authentication requires a TitleId in 1..=4294967295"
+            );
+        }
+    }
 }
 
