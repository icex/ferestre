+/* Datagram-level tracing, on the "dgram" channel.
+ *
+ * The winsock channel shows that a call happened and whether it succeeded, but
+ * not how much data moved or what it was. For a game protocol carried over UDP
+ * -- Minecraft Bedrock's RakNet among them -- that is the difference between
+ * "we are exchanging real data" and "we are trading keepalives while nothing
+ * progresses", which is exactly the question a stalled join poses. */
+static void trace_datagram( const char *what, SOCKET s, const WSABUF *buffers, DWORD count,
+                            const struct sockaddr *addr, DWORD size )
+{
+    unsigned int total = 0, i;
+    unsigned char id = 0;
+
+    if (!TRACE_ON(dgram)) return;
+    for (i = 0; i < count; i++) total += buffers[i].len;
+    if (count && buffers[0].len && buffers[0].buf) id = (unsigned char)buffers[0].buf[0];
+
+    /* The first bytes as hex, so a datagram can be decoded after the fact.
+     * RakNet's framing is in the clear even when the payload is not, and the
+     * packets that matter most -- the login and the encryption handshake --
+     * are exchanged before encryption starts, so they are readable here. */
+    {
+        static const char hex[] = "0123456789abcdef";
+        char dump[3 * 256 + 1];
+        unsigned int shown = 0, o = 0;
+
+        if (count && buffers[0].buf)
+        {
+            unsigned int avail = buffers[0].len < size ? buffers[0].len : size;
+            shown = avail < 256 ? avail : 256;
+            for (i = 0; i < shown; i++)
+            {
+                unsigned char c = (unsigned char)buffers[0].buf[i];
+                dump[o++] = hex[c >> 4];
+                dump[o++] = hex[c & 15];
+            }
+        }
+        dump[o] = 0;
+        TRACE_(dgram)( "%s sock %#Ix bytes %u/%u id %#04x peer %s data %s\n", what, s,
+                       (unsigned int)size, total, id,
+                       addr ? debugstr_sockaddr( addr ) : "(connected)", dump );
+    }
+}
