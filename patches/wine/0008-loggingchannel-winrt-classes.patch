+/* Windows.Foundation.Diagnostics.LoggingChannel.
+ *
+ * The channel a title's telemetry is written to. Nothing is written anywhere:
+ * the messages are ETW events for a Windows trace session that does not exist
+ * here, and the point of implementing the class is that the title gets an
+ * object back rather than a failure it does not check.
+ *
+ * The vtable order is the published one, not an inferred one. It matters more
+ * than usual here: the factory has two Create methods whose result pointer sits
+ * in a different argument, so a vtable one entry short does not fail, it writes
+ * an object pointer through whatever register the caller left holding a GUID. */
+struct logging_channel
+{
+    ILoggingChannel ILoggingChannel_iface;
+    ILoggingChannel2 ILoggingChannel2_iface;
+    IClosable IClosable_iface;
+    HSTRING name;
+    GUID id;
+    LONG ref;
+};
+
+static inline struct logging_channel *impl_from_ILoggingChannel( ILoggingChannel *iface )
+{
+    return CONTAINING_RECORD( iface, struct logging_channel, ILoggingChannel_iface );
+}
+
+static HRESULT WINAPI logging_channel_QueryInterface( ILoggingChannel *iface, REFIID iid, void **out )
+{
+    struct logging_channel *impl = impl_from_ILoggingChannel( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_ILoggingChannel ))
+    {
+        *out = &impl->ILoggingChannel_iface;
+        IInspectable_AddRef( *out );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_ILoggingChannel2 ))
+    {
+        *out = &impl->ILoggingChannel2_iface;
+        IInspectable_AddRef( *out );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_IClosable ))
+    {
+        *out = &impl->IClosable_iface;
+        IInspectable_AddRef( *out );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI logging_channel_AddRef( ILoggingChannel *iface )
+{
+    struct logging_channel *impl = impl_from_ILoggingChannel( iface );
+    return InterlockedIncrement( &impl->ref );
