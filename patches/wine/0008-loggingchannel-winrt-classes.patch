+/* Windows.Foundation.Diagnostics.LoggingChannelOptions.
+ *
+ * A title asked RoGetActivationFactory for this class, the lookup failed
+ * because nothing in the tree implements the namespace, and the title
+ * dereferenced what it got back and died before drawing a frame. It is an
+ * options bag for ETW-style logging: on a desktop with no ETW consumer,
+ * remembering the group and doing nothing else is the whole of the behaviour.
+ *
+ * Every interface asked for is logged, including the ones that are refused.
+ * The identifier of the factory is known -- a title asked for it by name -- and
+ * the rest are not published anywhere available here, so they are learned from
+ * what titles actually request rather than guessed at and shipped wrong. */
+struct logging_channel_options
+{
+    ILoggingChannelOptions ILoggingChannelOptions_iface;
+    GUID group;
+    LONG ref;
+};
+
+static inline struct logging_channel_options *impl_from_ILoggingChannelOptions( ILoggingChannelOptions *iface )
+{
+    return CONTAINING_RECORD( iface, struct logging_channel_options, ILoggingChannelOptions_iface );
+}
+
+static HRESULT WINAPI logging_options_QueryInterface( ILoggingChannelOptions *iface, REFIID iid, void **out )
+{
+    struct logging_channel_options *impl = impl_from_ILoggingChannelOptions( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_ILoggingChannelOptions ))
+    {
+        *out = &impl->ILoggingChannelOptions_iface;
+        IInspectable_AddRef( *out );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI logging_options_AddRef( ILoggingChannelOptions *iface )
+{
+    struct logging_channel_options *impl = impl_from_ILoggingChannelOptions( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI logging_options_Release( ILoggingChannelOptions *iface )
+{
+    struct logging_channel_options *impl = impl_from_ILoggingChannelOptions( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI logging_options_GetIids( ILoggingChannelOptions *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI logging_options_GetRuntimeClassName( ILoggingChannelOptions *iface, HSTRING *class_name )
+{
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+    return WindowsCreateString( RuntimeClass_Windows_Foundation_Diagnostics_LoggingChannelOptions,
+                                ARRAY_SIZE(RuntimeClass_Windows_Foundation_Diagnostics_LoggingChannelOptions) - 1,
+                                class_name );
+}
+
+static HRESULT WINAPI logging_options_GetTrustLevel( ILoggingChannelOptions *iface, TrustLevel *trust_level )
+{
+    TRACE( "iface %p, trust_level %p.\n", iface, trust_level );
