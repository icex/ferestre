# Maintainer: the ferestre contributors <https://github.com/icex/ferestre>

# The client: Microsoft sign-in, licences, content keys, MSIXVC download and
# decrypt -- and the only thing that can start a GDK title, because the title's
# executable is encrypted on disk and exists decrypted only inside a memfd that
# `xodus-cli run` hands to Wine.
#
# This is upstream Xodus (GPL-3.0) plus the patches in patches/xodus-cli/ of the
# ferestre repository. It is a third package rather than part of the
# launcher for three reasons, in order of weight:
#
#   1. Licence. Xodus is GPL-3.0 and the launcher is MIT. The launcher shells
#      out to this binary instead of linking its crates, and that separation is
#      easier to keep honest when the GPL-3.0 code is its own package with its
#      own licence field and its own source.
#   2. Build cost. This links webkit2gtk (the sign-in window). The launcher does
#      not. Nobody should rebuild webkit-linked code to pick up a launcher fix.
#   3. Provenance. It is someone else's project, carried as a fork. It moves on
#      its own schedule, not the launcher's.
#
# See ../README.md for the split, and for what has to change when the fork stops
# being a directory of patches.

pkgname=ferestre-client
pkgver=0.1.0.r130.g3e75c9f
pkgrel=2
pkgdesc='Xodus client for Microsoft Store titles, with the ferestre patches (sign-in, licences, MSIXVC download and decrypt)'
arch=('x86_64')
url='https://github.com/xodus-gaming/xodus'
license=('GPL-3.0-only')

# From the NEEDED entries of the built xodus-cli and xodus-service. webkit2gtk
# and gtk3 come from wry/tao, which draw the Microsoft sign-in window; the
# service itself needs only dbus and openssl.
depends=(
  'glibc' 'gcc-libs'
  'webkit2gtk-4.1'          # also supplies libjavascriptcoregtk-4.1
  'gtk3' 'gdk-pixbuf2' 'cairo' 'glib2'
  'libsoup3'
  'dbus'
  'openssl'
)
makedepends=(
  'cargo'
  'git'
  'protobuf'    # prost-build shells out to protoc for crates/xodus/proto/
)
optdepends=(
  'gnome-keyring: Secret Service provider for the account tokens'
  'kwallet: Secret Service provider for the account tokens (KDE)'
  'ferestre-git: the front end that drives this client'
)

# There is no other xodus-cli in the repositories today. Declaring these keeps
# the day an official one appears from being a surprise, and makes it obvious
# that this installs upstream's binary names.
provides=('xodus-cli' 'xodus-service')
conflicts=('xodus-cli' 'xodus-cli-git')

# THE FORK, PINNED.
#
# Verified by applying them here rather than assumed:
#
#   * upstream 3e75c9f + patch 0002 reproduces the fork's working tree exactly,
#     byte for byte, except Cargo.lock -- and the patch's Cargo.lock is the more
#     correct of the two, because it carries the p256/rand_core/base64 entries
#     the fork's committed lock is missing.
#   * patches 0003, 0004 and 0005 apply cleanly on top of that, in order.
#   * patch 0001 is an earlier export of work that 0002 already contains.
#     Applying it as well fails. It is deliberately not in the list below.
#
# So the base is pinned, not tracked: upstream main has moved past 3e75c9f and
# 0002 does not apply to it. Bumping this pin means re-basing the patches, which
# is exactly the maintenance the roadmap's "how is the client carried" question
# is about. When that is settled and the fork lives in a repository of its own,
# this becomes one git source and prepare() goes away.
_commit=3e75c9f2d3aad2ea2fdc488d92d0163eb68c1a60
# _patchrev pins a commit of THIS repository, so a history rewrite invalidates
# it: every URL below 404s permanently the moment the SHAs change. It has
# happened once already. If the history is ever rewritten again, repin here and
# in .SRCINFO, and regenerate the sha256sums -- the patch files themselves may
# have changed too.
_patchrev=9b87d64b3c877a1a277a75a4e818180f783c5069
_patchurl="https://raw.githubusercontent.com/icex/ferestre/$_patchrev/patches/xodus-cli"

# Every patch after 0001 is part of one ordered series. Keep the downloaded,
# applied and installed corresponding source lists together.
_patches=(
  "0002-relying-party-device-claim-and-no-panic.patch"
  "0003-owned-title-enumeration.patch"
  "0004-account-and-probe-headers.patch"
  "0005-win32-path-for-the-mapped-main-image.patch"
  "0006-streaming-progress-a-launcher-can-read-behind-XODUS_.patch"
  "0007-streaming-report-a-failed-download-instead-of-panick.patch"
  "0008-streaming-cached_len-must-mean-on-disk-not-accepted-.patch"
  "0009-xsts-mint-the-token-with-the-running-title-s-claim-n.patch"
  "0010-Let-a-UWP-product-reach-the-download-step-and-say-wh.patch"
  "0011-extract-a-container-that-stops-short-is-not-a-crash.patch"
  "0012-name-the-mapped-image-descriptor-after-its-file.patch"
  "0013-find-the-game-config-whatever-the-package-spells-it.patch"
  "0014-metadata-driven-title-authentication-and-service-discovery.patch"
  "0015-bound-memfd-diagnostic-labels.patch"
  "0016-query-the-authenticated-package-version.patch"
)
source=("xodus::git+https://github.com/xodus-gaming/xodus.git#commit=$_commit")
for _patch in "${_patches[@]}"; do
  source+=("$_patchurl/$_patch")
done
unset _patch
sha256sums=(
  'SKIP'
  '20d613add707a69f488b50041e53c60f8a0096132c05338b66d594fa8963c918'
  'c15806efefdfe7613755ada8ee0fe28784ad955ea7df26825ddeabc7be731256'
  '304c5e0f309c9609e9578f79f96fbf2800e429b72b26bbd590ad1e3fbdf05efd'
  'b5c9feec3aa4dba5f287609d5ae3727e5fb38aa4cf967997bfb5901d2b3a3d47'
  'ab51b007ed0b8802785be1b000ba78185f25760850174de55e2667ed64ac4a2d'
  'fae49957d9fb4725627c16c7c80224601c2102d772cfa54bb3dd9cb9dc996a0d'
  'f5943458e255ec7894c92b464db214f183f5681287f3d0189d31bb8771b908c1'
  'a45372720aa4e3363a87f7a69e27cf448c76d2801d25b30b561f28828a8d51f0'
  'b0e6618c9d86ed312cc1eeb43d124ae6cba591ad70b7151f907f7bcb41c89ca6'
  '7dd5152e24b082d55f9a942e2f2698efe5de6d7c3ac80390d23d5239c858964a'
  '46f134e88343abf8cffaead28ed3295bb061aa9a9a8139e17190322f89b29c1f'
  'e8a57479b49ddd74d4822536012728424b0c42188d7c3d76eee03d46f1d417f6'
  '70a2d6ba71e8834213fb3cb2e7bd423e9b9e243a7d78c1832854e006b1810ee9'
  '986af4b4508f2887ce7851b046145d5652db746052a40f659efa10136c8e7b84'
  '4448515542dfaa88b8d070a79544b32f2043b66091d61e5083426b0d7a1ff738'
