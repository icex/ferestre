From: Ferestre contributors
Subject: Retry Xbox user authentication after a rejected delegation ticket

Xbox user authentication can reject a delegation ticket with the d= prefix
(HTTP 400, empty response) while accepting the same ticket as t=. Reproduced
on 2026-11-02 with the installed 0.1.14 client and its existing credentials.

Try the original request first. Only a 400 for a nonempty d= ticket retries,
once, with t=. Regenerate the proof signature for the new request body.
Stored credentials and other token consumers keep their original form.

Local HTTP tests cover successful original requests, signed retries, retry
limits, unchanged non-delegation tickets and other HTTP failures. Live user
authentication accepted both the unprefixed ticket and the t= representation.

--- a/crates/xodus/src/api/xbox/auth.rs
+++ b/crates/xodus/src/api/xbox/auth.rs
@@ -8,20 +8,62 @@
     rps_ticket: String,
     signer: Option<&crate::api::xbox::signing::RequestSigner>,
 ) -> reqwest::Result<XstsResponse> {
+    authenticate_xbox_user_at(
+        client,
+        rps_ticket,
+        signer,
+        "https://user.auth.xboxlive.com/user/authenticate",
+    )
+    .await
+}
+
+async fn authenticate_xbox_user_at(
+    client: &reqwest::Client,
+    rps_ticket: String,
+    signer: Option<&crate::api::xbox::signing::RequestSigner>,
+    endpoint: &str,
+) -> reqwest::Result<XstsResponse> {
+    // Some delegation tickets are now rejected as d= but accepted as t=.
+    // Keep the original exchange first and retry only that specific rejection.
+    // The stored ticket and other MSA consumers must keep their original form.
+    let fallback = rps_ticket
+        .strip_prefix("d=")
+        .filter(|t| !t.is_empty())
+        .map(|t| format!("t={t}"));
+    let response = xbox_user_request(client, &rps_ticket, signer, endpoint)
+        .send()
+        .await?;
+    let response = match fallback {
+        Some(ticket) if response.status() == reqwest::StatusCode::BAD_REQUEST => {
+            // Rebuild the request: a proof-bound exchange must sign its new body.
+            xbox_user_request(client, &ticket, signer, endpoint)
+                .send()
+                .await?
+        }
+        _ => response,
+    };
+    response.error_for_status()?.json().await
+}
+
+fn xbox_user_request(
+    client: &reqwest::Client,
+    rps_ticket: &str,
+    signer: Option<&crate::api::xbox::signing::RequestSigner>,
+    endpoint: &str,
+) -> reqwest::RequestBuilder {
     let body = UserAuthRequest {
         relying_party: "http://auth.xboxlive.com".to_string(),
         token_type: "JWT".to_string(),
         properties: UserAuthProperties {
             auth_method: "RPS".to_string(),
             site_name: "user.auth.xboxlive.com".to_string(),
-            rps_ticket,
+            rps_ticket: rps_ticket.to_string(),
             proof_key: signer.map(|s| s.proof_key()),
         },
     };
-
     let payload = serde_json::to_vec(&body).expect("user auth request serialises");
     let mut request = client
-        .post("https://user.auth.xboxlive.com/user/authenticate")
+        .post(endpoint)
         .header("Content-Type", "application/json")
         .header("x-xbl-contract-version", "1");
     if let Some(signer) = signer {
@@ -30,9 +72,7 @@
             signer.sign(1, "POST", "/user/authenticate", "", &payload, 8192),
         );
     }
-    let resp = request.body(payload).send().await?.error_for_status()?;
-
-    resp.json().await
+    request.body(payload)
 }
 
 /// Authenticate this machine as a device.
@@ -372,3 +412,166 @@
