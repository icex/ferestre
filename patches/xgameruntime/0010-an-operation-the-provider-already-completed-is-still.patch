 static HRESULT WINAPI x_threading_XAsyncBegin( IXThreadingImpl *iface, XAsyncBlock *asyncBlock, void *context, const void *identity, const char *identityName, XAsyncProvider *provider )
 {
     struct x_async_op *op;
+    BOOL deliver;
     HRESULT hr;
 
     TRACE( "iface %p, asyncBlock %p, context %p, identity %p, identityName %s, provider %p.\n",
@@ -452,25 +481,66 @@ static HRESULT WINAPI x_threading_XAsyncBegin( IXThreadingImpl *iface, XAsyncBlo
     op->provider = provider;
     op->context = context;
     op->identity = identity;
-    op->ref = 1;
+    /* The list holds one reference; this frame holds the other until Begin
+     * returns, because a provider may finish the operation -- and another
+     * thread take its result, freeing it -- before that happens. */
+    op->ref = 2;
+
+    op->begin_running = TRUE;
 
     EnterCriticalSection( &async_ops_cs );
     list_add_tail( &async_ops, &op->entry );
     LeaveCriticalSection( &async_ops_cs );
+    TRACE( "operation %p registered for block %p (begin).\n", op, asyncBlock );
 
     {
         XAsyncProviderData data = { asyncBlock, 0, NULL, context };
         hr = provider( XAsyncOp_Begin, &data );
     }
 
-    if (FAILED(hr))
+    EnterCriticalSection( &async_ops_cs );
+    op->begin_running = FALSE;
+    deliver = op->deliver_pending;
+    op->deliver_pending = FALSE;
+    LeaveCriticalSection( &async_ops_cs );
+
+    /* Begin returning a failure does not mean the operation never started.
+     * E_PENDING says the work is under way, and a provider is free to finish
+     * the block from inside Begin and report E_PENDING all the same -- Forza
+     * Horizon 5's libHttpClient websocket send does exactly that.
+     *
+     * Withdrawing the operation there throws away the result its caller is
+     * about to ask for. The block still says "completed, 16 bytes", but the
+     * provider holding those bytes is gone, so XAsyncGetResult has nothing to
+     * fill the buffer with and the title reads a result that was never
+     * written: it poisons that local with -1 beforehand, and faults on the
+     * first field it reaches through. Only an operation that failed to start
+     * *and* never completed is ours to take back. */
+    if (FAILED(hr) && hr != E_PENDING)
     {
+        BOOL withdraw;
+
         EnterCriticalSection( &async_ops_cs );
-        list_remove( &op->entry );
+        withdraw = !op->completed && find_async_op( asyncBlock ) == op;
+        if (withdraw) list_remove( &op->entry );
         LeaveCriticalSection( &async_ops_cs );
-        async_op_invoke( op, XAsyncOp_Cleanup, 0, NULL );
-        release_async_op( op );
+
+        if (withdraw)
+        {
+            WARN( "operation %p withdrawn: the provider refused to begin block %p (%#lx).\n", op, asyncBlock, hr );
+            async_op_invoke( op, XAsyncOp_Cleanup, 0, NULL );
+            release_async_op( op );
+        }
+    }
+    /* Now, and not before: the operation's state is settled and this call is
+     * on its way out, so the title is past the point where the callback could
+     * catch it mid-setup. */
+    if (deliver)
+    {
+        TRACE( "delivering the held completion for block %p.\n", asyncBlock );
+        deliver_async_completion( asyncBlock );
     }
+    release_async_op( op );
     return hr;
 }
 
