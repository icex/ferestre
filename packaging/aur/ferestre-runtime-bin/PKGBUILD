# Maintainer: the ferestre contributors <https://github.com/icex/ferestre>

# The patched Proton runtime, prebuilt.
#
# Why -bin and not built here: building it is a container build of a whole Wine
# tree -- 2h09m measured on a free public CI runner, and it needs Docker or
# Podman with a Valve SDK image. That is not something an AUR helper should do
# behind a progress bar on someone's laptop.
#
# Why a separate package from the launcher: the runtime is 300 MB compressed
# and changes only when Wine or xgameruntime.dll changes; the launcher is a few
# hundred kilobytes and changes often. One package would mean a 300 MB download
# for a typo fix. See ../README.md.

pkgname=ferestre-runtime-bin
# Upstream's own version string is 'xodus-bleeding-edge-11.0-<date>-<n>-g<sha>';
# pkgver cannot hold the hyphens, so a release is <proton major>.<minor>.<date>.
pkgver=11.0.20260803
pkgrel=1
pkgdesc='Patched Proton with the ferestre Xbox GDK runtime implementation, prebuilt'
arch=('x86_64')
url='https://github.com/icex/ferestre'
# Valve's top-level Proton components are BSD-3-Clause, the Wine inside it and
# our xgameruntime.dll are LGPL-2.1-or-later, the bundled fonts are OFL-1.1, and
# the DXVK/vkd3d-proton pieces are zlib and LGPL. See NOTICE in the source repo.
license=('BSD-3-Clause' 'LGPL-2.1-or-later' 'OFL-1.1' 'Zlib')

# Everything below was derived from the installed tree rather than copied from
# another Proton package: every ELF file under files/ was read for its NEEDED
# entries, the sonames the tree satisfies itself were subtracted, and the rest
# were resolved to packages. dlopen()ed libraries do not appear in NEEDED, so
# the wine .so files were also scanned for soname strings; those are marked.
depends=(
  'glibc' 'gcc-libs'
  'python'                      # the top-level `proton` script

  # Graphics. libvulkan.so.1 and libEGL.so.1 are dlopened by win32u.so; a title
  # that cannot find a Vulkan ICD does not render at all.
  'vulkan-icd-loader' 'vulkan-driver' 'libglvnd' 'mesa' 'libdrm'

  # X11. winex11.so links libX11/libXext and dlopens the extension libraries.
  # There is no winewayland.so in this build, so a Wayland session goes through
  # XWayland and these are needed there too.
  'libx11' 'libxext' 'libxcb' 'libxcursor' 'libxcomposite' 'libxfixes'
  'libxi' 'libxinerama' 'libxrandr' 'libxrender' 'libxxf86vm'

  'freetype2' 'fontconfig'      # dlopened by win32u.so
  'alsa-lib' 'libpulse'         # winealsa.so, winepulse.so
  'systemd-libs' 'libusb'       # libudev for winebus.so; libusb for wineusb.so
  'libgudev'                    # libgstgl

  # TLS inside the title: bcrypt.so, crypt32.so and secur32.so all dlopen
  # gnutls. Without it a title's own HTTPS fails while the host's works.
  'gnutls' 'gmp'
  'krb5'                        # kerberos.so, and libsoup links libgssapi_krb5

  # Media. winedmo.so and the bundled gstreamer libav plugin link ffmpeg 4
  # (libavcodec.so.58), which on Arch is ffmpeg4.4, not ffmpeg. This is the
  # H.264 decode path; without it titles play colour bars instead of video.
  'ffmpeg4.4' 'mpg123' 'opus' 'libvorbis' 'libogg' 'libtheora' 'libva'

  # The tree ships its own GStreamer and libsoup; these are what they link.
  'glib2' 'zlib' 'brotli' 'libpsl' 'libnghttp2' 'sqlite'

  # libvosk.so, behind Windows.Media.SpeechRecognition. Small, and listing it
  # keeps the package's link closure complete.
  'blas' 'lapack'
)

optdepends=(
  'steam: registers the runtime as a Steam compatibility tool, and provides the STEAM_COMPAT_CLIENT_INSTALL_PATH Proton expects'
  'ferestre-git: the front end that actually launches titles with this runtime'
  'sdl2: gamepads through winebus SDL backend (udev/hidraw covers most controllers without it)'
  'libcups: printing from a title (localspl.so, winspool.so)'
  'v4l-utils: webcam capture (qcap.so)'
  'libgcrypt: alternative crypto backend for bcrypt.so'
  'nettle3: HLS streaming in the bundled GStreamer -- AUR, because Arch ships libnettle.so.9 and the plugin wants .so.8'
)

# Two sonames in the tree cannot be satisfied from the official repositories at
# all, and are deliberately absent above rather than listed as a dependency that
# will not install:
#
#   libnettle.so.8  Arch's nettle is .so.9. Only gstreamer's hlsdemux needs it.
#   libvpx.so.9     Arch's libvpx is .so.12. Only gstreamer's vpx plugin.
#
# Both are optional GStreamer plugins: the plugin fails to load, GStreamer logs
# it, and everything else works. No supported title uses either codec.
#
# The 32-bit half of the tree (files/lib/i386-*) is not covered either: it needs
# ~45 lib32-* packages and lib32-ffmpeg4.4 does not exist in the repositories,
# so it cannot be made complete. files/bin/wine and wineserver are x86_64 and
# every supported title is x86_64, so this only affects a title that ships a
# 32-bit helper executable. See ../README.md, "The 32-bit half".

install="$pkgname.install"

# The release tarball decides what carries symbols -- the roadmap strips during
# the build, where it can tell a Wine PE from an ELF. Re-stripping here would
# walk 1.4 GB to remove exactly the ELF symbols tools/winestack.c needs to
# symbolise a Wine backtrace. !debug follows: there is no source tree to point a
# debug package at.
options=('!strip' '!debug' 'emptydirs')

# RELEASE CONTRACT -- see ../README.md, "Cutting a runtime release".
# The asset is a zstd tarball whose single top-level directory is named exactly
# like the tarball's stem, and it is the installable compatibility tool: proton,
# toolmanifest.vdf, compatibilitytool.vdf, version, files/.
_tarball="ferestre-runtime-$pkgver-x86_64.tar.zst"
source=("$url/releases/download/runtime-$pkgver/$_tarball")

# SKIP is a placeholder, and the only honest value while no release exists: a
# made-up hash would fail with a confusing message instead of a clear one.
# Whoever cuts the first release replaces it by running `updpkgsums` in this
# directory, then regenerates .SRCINFO. Do not publish to the AUR with SKIP.
sha256sums=('SKIP')

package() {
  local src="$srcdir/ferestre-runtime-$pkgver"

  if [[ ! -d $src ]]; then
    printf '==> ERROR: the release tarball does not contain %s/\n' \
      "ferestre-runtime-$pkgver" >&2
    printf '    see the release contract in packaging/aur/README.md\n' >&2
    return 1
  fi

  # The same two checks scripts/install-xodus-proton.sh makes, for the same
  # reason: without the close_fds patch every GDK title exits 1, because
  # Proton's run_proc() closes the inherited file descriptors that hold the
  # decrypted executable, and without xgameruntime.dll there is no GDK
  # implementation at all. Both failures look like the title crashing.
  if ! grep -q 'close_fds=False' "$src/proton"; then
    printf '==> ERROR: this build closes inherited fds; every GDK title would exit 1\n' >&2
    return 1
  fi
  if [[ ! -f $src/files/lib/wine/x86_64-windows/xgameruntime.dll ]]; then
    printf '==> ERROR: no xgameruntime.dll in the runtime tree\n' >&2
    return 1
  fi

  # /usr/share/steam/compatibilitytools.d is the system-wide location Steam
  # scans in addition to the per-user one, and where a packaged Proton belongs:
  # proton-cachyos-slr installs itself at exactly this path. The tools in this
  # project do not probe it, so XODUS_PROTON_DIR still has to be set -- see
  # the .install file and ../README.md.
  install -d "$pkgdir/usr/share/steam/compatibilitytools.d"
  cp -a "$src" "$pkgdir/usr/share/steam/compatibilitytools.d/ferestre"

  install -Dm644 "$src/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  [[ -f $src/LICENSE.OFL ]] &&
    install -Dm644 "$src/LICENSE.OFL" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.OFL"
  [[ -f $src/PATENTS.AV1 ]] &&
    install -Dm644 "$src/PATENTS.AV1" "$pkgdir/usr/share/licenses/$pkgname/PATENTS.AV1"

  return 0
}
