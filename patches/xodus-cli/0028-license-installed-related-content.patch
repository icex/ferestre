+    fn related_from_json(json: &str) -> Result<HashMap<String, Arc<Self>>, String> {
+        let entries: HashMap<String, String> =
+            serde_json::from_str(json).map_err(|_| "invalid related Store content binding")?;
+        if entries.len() > 128 {
+            return Err("too many related Store packages".into());
+        }
+        let mut related = HashMap::new();
+        for (product, content) in entries {
+            if product.len() != 12
+                || !product.bytes().all(|b| b.is_ascii_alphanumeric())
+                || !uuid_valid(&content)
+            {
+                return Err("invalid related Store package identity".into());
+            }
+            let product = product.to_ascii_uppercase();
+            if related.contains_key(&product) {
+                return Err("duplicate related Store package".into());
+            }
+            related.insert(
+                product.clone(),
+                Arc::new(Self {
+                    product,
+                    content,
+                    cached: Default::default(),
+                    family: Default::default(),
+                    related: Default::default(),
+                }),
+            );
+        }
+        Ok(related)
+    }
