+                 "RelyingParty": "http://licensing.example.test", "SignaturePolicyIndex": 0}
+            ],
+            "SignaturePolicies": [{
+                "Version": 1, "MaxBodyBytes": 8192,
+                "SupportedAlgorithms": ["ES256"], "SupportedSignatureTypes": ["XBL"]
+            }]
+        }))
