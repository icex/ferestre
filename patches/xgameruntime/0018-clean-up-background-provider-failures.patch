-static void complete_failed_begin( struct x_async_op *op, HRESULT hr )
+static void complete_provider_failure( struct x_async_op *op, HRESULT hr )
 {
     BOOL drop = FALSE;
 
@@ -236,7 +236,7 @@ static void complete_failed_begin( struct x_async_op *op, HRESULT hr )
         op->cleanup_on_release = TRUE;
