prepare() {
  cd "$srcdir/xodus"

  # Apply in order: each patch targets the tree left by its predecessor.
  local patch
  for patch in "${_patches[@]}"; do
    git apply -v "$srcdir/$patch"
  done

  # Fetch after patching: the patches change Cargo.toml and Cargo.lock, and the
  # build below is offline.
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$srcdir/xodus"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target

  # Upstream sets -Ctarget-feature=+aes,+ssse3 in .cargo/config.toml for the
  # MSIXVC decrypt path, and an exported RUSTFLAGS -- which makepkg sets --
  # silently overrides that file. Put it back, or every download decrypts on
  # the software AES fallback. The cost is upstream's own: a CPU older than
  # about 2011 has no AES-NI and the binary dies with an illegal instruction.
  export RUSTFLAGS="${RUSTFLAGS:-} -Ctarget-feature=+aes,+ssse3"

  cargo build --frozen --release --workspace
}

# No check(). Not a judgement about the tests -- they were not run while writing
# this, so the package does not claim they pass. `cargo test --frozen
# --workspace` belongs here once someone has confirmed the suite needs neither
# network nor a Secret Service, which a build chroot has neither of.

package() {
  cd "$srcdir/xodus"

  install -Dm755 target/release/xodus-cli     "$pkgdir/usr/bin/xodus-cli"
  install -Dm755 target/release/xodus-service "$pkgdir/usr/bin/xodus-service"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  # The corresponding source for a GPL-3.0 binary is upstream plus these; ship
  # them so the package carries its own provenance.
  local patch
  for patch in "${_patches[@]}"; do
    install -Dm644 "$srcdir/$patch" \
      "$pkgdir/usr/share/licenses/$pkgname/patches/$patch"
  done
}
