diff --git a/dxvk.conf b/dxvk.conf
index b67cd92..62bb0fe 100644
--- a/dxvk.conf
+++ b/dxvk.conf
@@ -11,7 +11,10 @@
 # Many (broken) games will need this to be set to consider exposing HDR output
 # as determine it based on the DXGIOutput's current ColorSpace instead of
 # using CheckColorSpaceSupport.
-# This defaults to the value of the DXVK_HDR environment variable.
+# On Win32 this defaults to automatic detection of the active output's HDR state.
+# HDR10 presentation also requires support from the Vulkan surface.
+# DXVK_HDR=0 or dxgi.enableHDR=False disables it; DXVK_NO_HDR=1 takes precedence.
+# Other WSI backends retain the DXVK_HDR=1 opt-in.
 #
 # Supported values: True, False
 
diff --git a/src/dxgi/dxgi_options.cpp b/src/dxgi/dxgi_options.cpp
index d539111..160af95 100644
--- a/src/dxgi/dxgi_options.cpp
+++ b/src/dxgi/dxgi_options.cpp
@@ -199,7 +199,14 @@ namespace dxvk {
       this->hideIntelGpu = true;
     }
 
-    this->enableHDR = config.getOption<bool>("dxgi.enableHDR", env::getEnvVar("DXVK_HDR") == "1");
+    const std::string hdr = env::getEnvVar("DXVK_HDR");
+    bool enableHdrDefault = hdr == "1";
+#ifdef _WIN32
+    // Wine reports the active output state; HDR10 also needs surface support.
+    enableHdrDefault |= hdr.empty();
+#endif
+    this->enableHDR = config.getOption<bool>("dxgi.enableHDR", enableHdrDefault)
+                  && env::getEnvVar("DXVK_NO_HDR") != "1";
 
     bool enableUe4Workarounds = config.getOption<bool>("dxgi.enableUe4Workarounds", false);
 
