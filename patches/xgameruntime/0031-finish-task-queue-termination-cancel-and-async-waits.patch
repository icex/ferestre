+/* Ask the provider to stop, then make sure the operation finishes either way.
+ *
+ * This was a stub, so a cancelled operation only ended when its work did on
+ * its own -- possibly never, for a websocket or a long poll -- and a title
+ * backing out of a menu or shutting down waited for a completion callback that
+ * did not come. The GDK completes a cancelled operation with E_ABORT unless
+ * the provider has already completed it; a completion the provider makes
+ * afterwards is ignored, like any second one. */
+static void WINAPI x_threading_XAsyncCancel( IXThreadingImpl *iface, XAsyncBlock *asyncBlock )
+{
+    struct x_async_op *op;
+    BOOL cancel;
+
+    TRACE( "iface %p, asyncBlock %p.\n", iface, asyncBlock );
+
+    if (!asyncBlock || !(op = acquire_async_op( asyncBlock ))) return;
+
+    EnterCriticalSection( &async_ops_cs );
+    cancel = !op->completed && !op->canceling;
+    op->canceling = TRUE;
+    LeaveCriticalSection( &async_ops_cs );
+
+    if (cancel)
+    {
+        BOOL done;
+
+        TRACE( "cancelling operation %p for block %p.\n", op, asyncBlock );
+        async_op_invoke( op, XAsyncOp_Cancel, 0, NULL );
+        EnterCriticalSection( &async_ops_cs );
+        done = op->completed;
+        LeaveCriticalSection( &async_ops_cs );
+        if (!done) complete_op_without_result( op, E_ABORT );
+    }
+    release_async_op( op );
+}
