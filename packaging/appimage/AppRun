#!/bin/bash
# AppDir entry point.
#
# This is deliberately almost empty, and that is the interesting part.
#
# The conventional AppRun exports LD_LIBRARY_PATH=$APPDIR/usr/lib and friends so
# a bundled GUI toolkit is found. We must not: the launcher's whole job is to
# start Proton, Proton has to run against the *host* graphics stack (its
# binaries pull in 66 distinct host libraries), and every variable exported here
# is inherited by that process tree. A bundled library that wins over the host's
# is a rendering or audio bug three layers away from anything that looks like
# packaging. scripts/launch-gdk.sh already unsets LD_PRELOAD and
# LD_LIBRARY_PATH for the same reason; do not give it more to undo.
#
# The other thing to know: the AppImage is mounted for exactly as long as this
# process lives. usr/lib/ferestre/scripts, including proton-wine-shim.sh which
# xodus-cli execs as its "wine" binary, lives on that mount. So the launcher
# must stay in the foreground for the lifetime of the game and must never
# daemonise itself away. It execs, and waits.

set -u

HERE=$(dirname "$(readlink -f "$0")")
export APPDIR="${APPDIR:-$HERE}"

# Only our own binary lives here, so nothing on the host can be shadowed.
export PATH="$APPDIR/usr/bin:$PATH"

# Where the shell scripts and patches landed inside the AppDir. The placeholder
# command falls back to its own location, so this is belt and braces for anyone
# invoking usr/bin/ferestre directly out of an extracted AppDir.
export FERESTRE_SCRIPTS_DIR="${FERESTRE_SCRIPTS_DIR:-$APPDIR/usr/lib/ferestre/scripts}"

# The executable is built before the release tag is known. Keep the tag in the
# staged file and let the command report it, so `ferestre version` identifies
# the AppImage somebody actually downloaded.
if [ -r "$APPDIR/usr/lib/ferestre/VERSION" ]; then
    export FERESTRE_PACKAGE_VERSION="${FERESTRE_PACKAGE_VERSION:-$(cat "$APPDIR/usr/lib/ferestre/VERSION")}"
fi

# The release image contains the GPL client and the patched Proton runtime. A
# caller can still override either path for development, but a fresh machine
# must not need a second package before it can sign in or run a title.
if [ -x "$APPDIR/usr/lib/ferestre/client/xodus-cli" ]; then
    export XODUS_CLI_DIR="${XODUS_CLI_DIR:-$APPDIR/usr/lib/ferestre/client}"
fi
if [ -d "$APPDIR/usr/lib/ferestre/runtime" ]; then
    export XODUS_PROTON_DIR="${XODUS_PROTON_DIR:-$APPDIR/usr/lib/ferestre/runtime}"
fi

# No arguments means somebody clicked the icon, so open the window; arguments
# mean they typed a command, so run the CLI. Desktop integrators rewrite a
# .desktop `Exec=` to the AppImage's own path and drop the binary name, so this
# dispatch -- not the desktop entry -- is what decides which one starts.
if [ $# -eq 0 ] && [ -x "$APPDIR/usr/bin/ferestre-gui" ]; then
    exec "$APPDIR/usr/bin/ferestre-gui"
fi
exec "$APPDIR/usr/bin/ferestre" "$@"
