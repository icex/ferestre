+/* Windows.Foundation.Diagnostics.LoggingOptions.
+ *
+ * The per-event options a title passes alongside a logged message: ETW
+ * keywords, tags, task and opcode, and the activity ids that correlate one
+ * event with another. All of it is bookkeeping for a trace session, so the
+ * object stores what it is given and hands it back.
+ *
+ * Storing it rather than ignoring it is not politeness. A title that sets a
+ * property and reads it back expects its own value; XSAPI does exactly that
+ * while building its channel, and a getter that answered zero would send it
+ * down a path meant for a runtime that does not support logging. */
+struct logging_options
+{
+    ILoggingOptions ILoggingOptions_iface;
+    LONG ref;
+    INT64 keywords;
+    INT32 tags;
+    INT16 task;
+    LoggingOpcode opcode;
+    GUID activity_id;
+    GUID related_activity_id;
+};
