@@ -848,10 +907,8 @@
         return FALSE;
     }
 
-    async = item->async;
-    free( item );
-    TRACE( "delivering completion for block %p (dispatch).\n", async );
-    if (async->callback) async->callback( async );
+    TRACE( "delivering completion for block %p (dispatch).\n", item->async );
