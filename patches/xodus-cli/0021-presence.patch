+
+    // Explicit ids win, but the directory still names the game.
+    let (identity, name) =
+        resolve_identity(Some(dir.path()), Some(42), Some("explicit".into())).expect("explicit");
+    assert_eq!(
+        (identity.title_id, identity.client_id.as_str()),
+        (42, "explicit")
