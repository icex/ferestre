+    product.entitlement = Some(crate::entitlement::Entitlement::fixture("9P5786PJB9RP"));
+    let mut titled = crate::simple_context::tests::context("owner-list", "player-list");
+    titled.title = Some(crate::title::TitleIdentity::fixture(
+        1805509784,
+        "own-client",
