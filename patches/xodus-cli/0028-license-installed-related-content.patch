+    #[tokio::test]
+    async fn related_packages_keep_separate_grants_and_refuse_unbound_products() {
+        let context = crate::simple_context::tests::context("related-owner", "related-player");
+        let owner = context.store_context().tokens().clone();
+        let mut binding = Entitlement::fixture("9TESTROLE0ID");
+        let root = Arc::get_mut(&mut binding).unwrap();
+        root.related = Entitlement::related_from_json(r#"{"9TESTADDON01":"00000000-0000-0000-0000-000000000002","9TESTADDON02":"00000000-0000-0000-0000-000000000003"}"#).unwrap();
+        *root.related["9TESTADDON01"].cached.lock().await = Some(Check {
+            at: Instant::now(),
+            valid: true,
+            granted: Some(Instant::now()),
+        });
+        assert!(root.valid("9TESTADDON01", &context.client, &owner).await);
+        assert!(!root.valid("9TESTROLE0ID", &context.client, &owner).await);
+        assert!(!root.valid("9TESTADDON02", &context.client, &owner).await);
+        assert!(!root.valid("9TESTOTHER00", &context.client, &owner).await);
+        context.store_context().tokens().remove_user().unwrap();
+        assert!(!root.valid("9TESTADDON01", &context.client, &owner).await);
+    }
