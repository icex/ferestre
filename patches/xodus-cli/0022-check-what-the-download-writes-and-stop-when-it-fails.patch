+        let p = package();
+        let mut bytes = p.bytes.clone();
+        flip(&mut bytes, p.user_data_page * PAGE_SIZE + 100);
+        let err = parse_verified(&bytes).await.err().unwrap();
+        assert!(
+            err.to_string().contains("does not match its hash tree"),
